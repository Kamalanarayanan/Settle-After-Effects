<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="com.critstudio.settle"
                   ExtensionBundleName="Settle"
                   ExtensionBundleVersion="0.2.2"
                   Version="9.0">

  <ExtensionList>
    <Extension Id="com.critstudio.settle.panel" Version="0.2.2"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- AEFT 16.0 is After Effects CC 2019. 99.9 keeps future versions loading. -->
      <Host Name="AEFT" Version="[16.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <!-- Deliberately low. A higher CSXS number here blocks older hosts and
           buys nothing, since this panel uses no CEP 10+ APIs. -->
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.critstudio.settle.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <!-- Node.js is intentionally disabled. This panel never touches the
               filesystem or network, which keeps it installable in locked-down studios. -->
          <CEFCommandLine/>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Settle</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>380</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
